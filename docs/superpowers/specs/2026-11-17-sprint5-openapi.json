{
  "openapi": "3.1.0",
  "info": {"title": "NimbusOps Sprint 5 additive provisioning contract", "version": "1.0.0-design", "description": "Design only. Read with 2026-11-17-sprint5-full-design.md. Cookie mutations require existing origin/CSRF guards. Legacy routes are not redefined here.", "license": {"name": "Private project specification"}},
  "servers": [{"url": "/api/v1"}],
  "security": [{"OperatorSession": []}],
  "tags": [{"name": "Provisioning", "description": "Authorized durable jobs and sanitized history"}, {"name": "ManagedAgent", "description": "Independent scoped bootstrap, never operator cookie authority"}],
  "paths": {
    "/provisioning/providers": {"get": {"operationId": "listProvisioningProviders", "summary": "ADMIN: list configured provider readiness", "tags": ["Provisioning"], "x-role": "ADMIN", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Paged configured connections; no secrets", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderPage"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provider-connections/{connection_id}/targets": {"parameters": [{"name": "connection_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "get": {"operationId": "listProvisioningTargets", "summary": "ADMIN: discover only configured authorized scope", "tags": ["Provisioning"], "x-role": "ADMIN", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Paged target inventory; discovery does not authorize installation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TargetPage"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provisioning-validations": {"post": {"operationId": "createProvisioningValidation", "summary": "ADMIN: run explicitly permitted nonmutating checks and freeze review", "tags": ["Provisioning"], "x-role": "ADMIN", "x-csrf-origin-required": true, "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ValidationRequest"}}}}, "responses": {"201": {"description": "Immutable review; failed checks are represented, not install success", "headers": {"Location": {"schema": {"type": "string"}, "description": "Validation resource URI"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Validation"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provisioning-validations/{validation_id}": {"parameters": [{"name": "validation_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "get": {"operationId": "getProvisioningValidation", "summary": "ADMIN: read own immutable review", "tags": ["Provisioning"], "x-role": "ADMIN", "responses": {"200": {"description": "Review and expiry", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Validation"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provisioning-jobs": {
      "post": {"operationId": "createProvisioningJob", "summary": "ADMIN: approve immutable validation and queue one job", "tags": ["Provisioning"], "x-role": "ADMIN", "x-csrf-origin-required": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Approval"}, "example": {"validation_id": "e69aebed-e07f-4714-8a38-fcbf544d3ec3", "approval_fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "confirmed": true}}}}, "responses": {"202": {"$ref": "#/components/responses/AcceptedJob"}, "default": {"$ref": "#/components/responses/Problem"}}},
      "get": {"operationId": "listProvisioningJobs", "summary": "Read sanitized history; VIEWER omits provider internals and actors", "tags": ["Provisioning"], "x-role": "VIEWER_OR_ADMIN", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"name": "state", "in": "query", "schema": {"$ref": "#/components/schemas/State"}}, {"name": "provider", "in": "query", "schema": {"$ref": "#/components/schemas/Provider"}}, {"name": "host_id", "in": "query", "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Keyset-paged history descending created_at,id", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobPage"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}
    },
    "/provisioning-jobs/{job_id}": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "get": {"operationId": "getProvisioningJob", "summary": "Read truthful job state, uncertainty and allowed actions", "tags": ["Provisioning"], "x-role": "VIEWER_OR_ADMIN", "responses": {"200": {"description": "Sanitized job", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provisioning-jobs/{job_id}/events": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "get": {"operationId": "listProvisioningJobEvents", "summary": "Read ordered durable events after an exclusive sequence", "tags": ["Provisioning"], "x-role": "VIEWER_OR_ADMIN", "parameters": [{"name": "after_sequence", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"description": "Sequence-paged events; poll no faster than every 2 seconds", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provisioning-jobs/{job_id}/cancellation": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "post": {"operationId": "requestProvisioningCancellation", "summary": "ADMIN: persist idempotent cooperative cancellation intent", "tags": ["Provisioning"], "x-role": "ADMIN", "x-csrf-origin-required": true, "responses": {"202": {"$ref": "#/components/responses/AcceptedJob"}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/provisioning-jobs/{job_id}/retries": {"parameters": [{"$ref": "#/components/parameters/JobId"}], "post": {"operationId": "retryProvisioningJob", "summary": "ADMIN: create a safely linked child with fresh approval", "tags": ["Provisioning"], "x-role": "ADMIN", "x-csrf-origin-required": true, "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Approval"}}}}, "responses": {"202": {"$ref": "#/components/responses/AcceptedJob"}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/agents/provisioning-grants": {"post": {"operationId": "exchangeProvisioningWorkloadIdentity", "summary": "Exchange independently authorized VM identity for one dispatch capability", "description": "Azure only; validate trusted tenant/issuer/audience/signature/time/principal and authoritative target binding. No cookie/agent-token fallback. Request and response bodies MUST NOT be logged.", "tags": ["ManagedAgent"], "security": [{"VMWorkloadIdentity": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DispatchBinding"}}}}, "responses": {"201": {"description": "Ephemeral capability, never browser-visible or durable server plaintext", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Grant"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/agents/managed-enrollments": {"post": {"operationId": "commitManagedEnrollment", "summary": "Atomically commit target-generated credential under a scoped grant", "description": "Bodies and headers excluded from logs. Same consumed grant/candidate can replay safe original metadata; never authenticates an invalidated credential or un-revokes after a later revoke. Different candidate conflicts. protocol_version is explicit.", "tags": ["ManagedAgent"], "security": [{"EnrollmentGrant": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManagedEnrollmentRequest"}}}}, "responses": {"200": {"description": "Safe original commit metadata (also first commit); does not imply runtime verification", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CredentialCommit"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/agents/managed-enrollments/{commit_id}": {"parameters": [{"name": "commit_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "X-Host-Id", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}}], "get": {"operationId": "getOwnManagedCredentialCommit", "summary": "Current credential only: read own credential commit status", "tags": ["ManagedAgent"], "security": [{"CurrentAgentCredential": []}], "responses": {"200": {"description": "Current commit metadata; grace and revoked credentials denied", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CredentialCommit"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {
      "OperatorSession": {"type": "apiKey", "in": "cookie", "name": "nimbusops_session", "description": "Verified baseline operators.py session cookie. Cookie mutations require existing Origin checks and X-CSRF-Token validation."},
      "VMWorkloadIdentity": {"type": "http", "scheme": "bearer", "bearerFormat": "Azure workload JWT", "description": "Explicit tenant/audience/principal/VM binding, independent of host enrollment"},
      "EnrollmentGrant": {"type": "http", "scheme": "bearer", "description": "Single dispatch/target/job capability, short-lived, never a normal agent token"},
      "CurrentAgentCredential": {"type": "http", "scheme": "bearer", "description": "Existing agent token plus X-Host-Id, CURRENT match only; revoked/grace denied"}
    },
    "parameters": {
      "Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 2048}, "description": "Opaque integrity-protected keyset cursor bound to filters"},
      "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}},
      "JobId": {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"}, "description": "Scoped to actor and route; same normalized request returns same job, mismatch409; nonsecret"}
    },
    "responses": {
      "AcceptedJob": {"description": "Accepted or idempotently replayed job; never installation success", "headers": {"Location": {"description": "Job resource URI", "schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
      "Problem": {"description": "RFC 9457: 400 malformed request/cursor,401 unauthenticated,403 forbidden,404 unknown/out-of-scope,409 idempotency/ownership/state conflict,410 expired review/grant,422 invalid/unsupported config,429 rate limit,500 internal,503 setup/provider/DB unavailable. See design error catalog. Never raw stderr/secrets.", "headers": {"Retry-After": {"description": "Seconds, mandatory on429 and transient503", "schema": {"type": "integer", "minimum": 1}}}, "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}, "example": {"type": "urn:nimbusops:problem:target-busy", "title": "Target busy", "status": 409, "code": "TARGET_BUSY", "detail": "An unresolved operation owns this target.", "request_id": "request-opaque", "retryable": false, "remediation": "Inspect the owning job and reconcile through the authorized management channel."}}}}
    },
    "schemas": {
      "Provider": {"type": "string", "enum": ["LOCAL_WINDOWS", "GENERIC_LINUX", "AZURE_VM"]},
      "Operation": {"type": "string", "enum": ["INSTALL", "REENROLL", "ROTATE", "RESTART", "DIAGNOSE", "UPGRADE"]},
      "State": {"type": "string", "enum": ["PENDING", "VALIDATING", "RUNNING", "VERIFYING", "SUCCEEDED", "FAILED", "CANCELLED"]},
      "Hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "Pagination": {"type": "object", "additionalProperties": false, "required": ["next_cursor", "has_more"], "properties": {"next_cursor": {"type": ["string", "null"]}, "has_more": {"type": "boolean"}}},
      "ProviderConnection": {"type": "object", "additionalProperties": false, "required": ["id", "provider", "name", "setup_state", "operations", "remediation"], "properties": {"id": {"type": "string", "format": "uuid"}, "provider": {"$ref": "#/components/schemas/Provider"}, "name": {"type": "string", "maxLength": 128}, "setup_state": {"type": "string", "enum": ["READY", "SETUP_REQUIRED", "PERMISSION_DENIED", "UNAVAILABLE"]}, "operations": {"type": "array", "items": {"$ref": "#/components/schemas/Operation"}}, "remediation": {"type": ["string", "null"], "maxLength": 1024}}},
      "Target": {"type": "object", "additionalProperties": false, "required": ["id", "connection_id", "name", "platform", "host_id", "mapping_status", "supported"], "properties": {"id": {"type": "string", "format": "uuid"}, "connection_id": {"type": "string", "format": "uuid"}, "name": {"type": "string", "maxLength": 255}, "platform": {"type": "string", "maxLength": 128}, "host_id": {"type": ["string", "null"], "format": "uuid"}, "mapping_status": {"type": "string", "enum": ["UNMAPPED", "VERIFIED", "CONFLICT"]}, "supported": {"type": "boolean"}}},
      "Config": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_digest", "mode", "environment", "hostname"], "properties": {"schema_version": {"const": 1}, "artifact_digest": {"$ref": "#/components/schemas/Hash"}, "mode": {"type": "string", "enum": ["TELEMETRY_ONLY", "PRESERVE"], "description": "INSTALL requires TELEMETRY_ONLY; lifecycle requires PRESERVE. Server resolves reviewed effective mode without granting Docker."}, "effective_mode": {"type": "string", "enum": ["TELEMETRY_ONLY", "EXECUTOR"], "readOnly": true}, "environment": {"type": "string", "enum": ["PRIVATE", "PUBLIC-CLOUD"]}, "hostname": {"type": "string", "minLength": 1, "maxLength": 253}, "config_hash": {"$ref": "#/components/schemas/Hash", "readOnly": true}}},
      "ValidationRequest": {"type": "object", "additionalProperties": false, "required": ["target_id", "operation", "config"], "properties": {"target_id": {"type": "string", "format": "uuid"}, "operation": {"$ref": "#/components/schemas/Operation"}, "config": {"$ref": "#/components/schemas/Config"}, "expected_host_id": {"type": "string", "format": "uuid"}}},
      "Check": {"type": "object", "additionalProperties": false, "required": ["code", "passed", "detail"], "properties": {"code": {"type": "string", "maxLength": 64}, "passed": {"type": "boolean"}, "detail": {"type": "string", "maxLength": 1024}}},
      "Validation": {"type": "object", "additionalProperties": false, "required": ["id", "target_id", "operation", "config", "approval_fingerprint", "expires_at", "passed", "privileged_actions", "checks"], "properties": {"id": {"type": "string", "format": "uuid"}, "target_id": {"type": "string", "format": "uuid"}, "operation": {"$ref": "#/components/schemas/Operation"}, "config": {"$ref": "#/components/schemas/Config"}, "approval_fingerprint": {"$ref": "#/components/schemas/Hash"}, "expires_at": {"type": "string", "format": "date-time"}, "passed": {"type": "boolean"}, "privileged_actions": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 512}}, "checks": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/Check"}}}},
      "Approval": {"type": "object", "additionalProperties": false, "required": ["validation_id", "approval_fingerprint", "confirmed"], "properties": {"validation_id": {"type": "string", "format": "uuid"}, "approval_fingerprint": {"$ref": "#/components/schemas/Hash"}, "confirmed": {"const": true}}},
      "Evidence": {"type": "object", "additionalProperties": false, "required": ["heartbeat_received_at", "telemetry_received_at", "credential_version", "runtime_instance_id"], "properties": {"heartbeat_received_at": {"type": "string", "format": "date-time"}, "telemetry_received_at": {"type": "string", "format": "date-time"}, "credential_version": {"type": "integer", "minimum": 1}, "runtime_instance_id": {"type": "string", "format": "uuid"}}},
      "Job": {"type": "object", "additionalProperties": false, "required": ["id", "provider", "operation", "state", "step", "host_id", "created_at", "updated_at", "reconciliation_required", "reason_code", "cancel_requested", "allowed_actions", "evidence"], "properties": {"id": {"type": "string", "format": "uuid"}, "provider": {"$ref": "#/components/schemas/Provider"}, "operation": {"$ref": "#/components/schemas/Operation"}, "state": {"$ref": "#/components/schemas/State"}, "step": {"type": ["string", "null"], "maxLength": 64}, "host_id": {"type": ["string", "null"], "format": "uuid"}, "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "reconciliation_required": {"type": "boolean"}, "reason_code": {"type": ["string", "null"], "maxLength": 64}, "cancel_requested": {"type": "boolean"}, "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["REQUEST_CANCEL", "RETRY"]}}, "evidence": {"oneOf": [{"$ref": "#/components/schemas/Evidence"}, {"type": "null"}]}}},
      "Event": {"type": "object", "additionalProperties": false, "required": ["sequence", "at", "code", "state", "detail"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "at": {"type": "string", "format": "date-time"}, "code": {"type": "string", "maxLength": 64}, "state": {"$ref": "#/components/schemas/State"}, "detail": {"type": "string", "maxLength": 1024}}},
      "ProviderPage": {"type": "object", "additionalProperties": false, "required": ["data", "pagination"], "properties": {"data": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/ProviderConnection"}}, "pagination": {"$ref": "#/components/schemas/Pagination"}}},
      "TargetPage": {"type": "object", "additionalProperties": false, "required": ["data", "pagination"], "properties": {"data": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Target"}}, "pagination": {"$ref": "#/components/schemas/Pagination"}}},
      "JobPage": {"type": "object", "additionalProperties": false, "required": ["data", "pagination"], "properties": {"data": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Job"}}, "pagination": {"$ref": "#/components/schemas/Pagination"}}},
      "EventPage": {"type": "object", "additionalProperties": false, "required": ["data", "next_sequence", "has_more"], "properties": {"data": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Event"}}, "next_sequence": {"type": "integer", "minimum": 0}, "has_more": {"type": "boolean"}}},
      "DispatchBinding": {"type": "object", "additionalProperties": false, "required": ["job_id", "dispatch_id", "protocol_version"], "properties": {"job_id": {"type": "string", "format": "uuid"}, "dispatch_id": {"type": "string", "format": "uuid"}, "protocol_version": {"const": 1}}},
      "Grant": {"type": "object", "additionalProperties": false, "required": ["grant", "expires_at"], "properties": {"grant": {"type": "string", "minLength": 32, "maxLength": 256, "writeOnly": false, "description": "SECRET: in-memory protected-channel response only; never browser/log/URL/argv"}, "expires_at": {"type": "string", "format": "date-time"}}},
      "ManagedEnrollmentRequest": {"type": "object", "additionalProperties": false, "required": ["protocol_version", "job_id", "dispatch_id", "candidate_id", "candidate_credential", "hostname"], "properties": {"protocol_version": {"const": 1}, "job_id": {"type": "string", "format": "uuid"}, "dispatch_id": {"type": "string", "format": "uuid"}, "candidate_id": {"type": "string", "format": "uuid"}, "candidate_credential": {"type": "string", "minLength": 32, "maxLength": 256, "writeOnly": true}, "hostname": {"type": "string", "maxLength": 253}, "expected_host_id": {"type": "string", "format": "uuid"}, "expected_credential_version": {"type": "integer", "minimum": 1}}},
      "CredentialCommit": {"type": "object", "additionalProperties": false, "required": ["commit_id", "host_id", "credential_version", "committed_at", "current"], "properties": {"commit_id": {"type": "string", "format": "uuid"}, "host_id": {"type": "string", "format": "uuid"}, "credential_version": {"type": "integer", "minimum": 1}, "committed_at": {"type": "string", "format": "date-time"}, "current": {"type": "boolean", "description": "Evaluated at read time; false if superseded or revoked. Safe promotion still requires current-credential authenticated status; grace/revoked token gets401."}}},
      "ProvisioningHeartbeatProof": {"type": "object", "additionalProperties": false, "required": ["job_id", "runtime_instance_id", "challenge_id", "challenge", "sample_sequence", "config_hash", "artifact_digest"], "description": "Optional nested provisioning_proof on existing heartbeat. Does not replace actual bearer-token auth; proof/body never logged.", "properties": {"job_id": {"type": "string", "format": "uuid"}, "runtime_instance_id": {"type": "string", "format": "uuid"}, "challenge_id": {"type": "string", "format": "uuid"}, "challenge": {"type": "string", "minLength": 32, "maxLength": 256, "writeOnly": true}, "sample_sequence": {"type": "integer", "minimum": 1}, "config_hash": {"$ref": "#/components/schemas/Hash"}, "artifact_digest": {"$ref": "#/components/schemas/Hash"}}},
      "ProvisioningTelemetryProof": {"type": "object", "additionalProperties": false, "required": ["job_id", "runtime_instance_id", "sample_sequence"], "description": "Optional nested provisioning_proof on existing telemetry; existing real metric payload remains required.", "properties": {"job_id": {"type": "string", "format": "uuid"}, "runtime_instance_id": {"type": "string", "format": "uuid"}, "sample_sequence": {"type": "integer", "minimum": 1}}},
      "Problem": {"type": "object", "additionalProperties": false, "required": ["type", "title", "status", "code", "detail", "request_id", "retryable", "remediation"], "properties": {"type": {"type": "string", "format": "uri"}, "title": {"type": "string", "maxLength": 128}, "status": {"type": "integer", "minimum": 400, "maximum": 599}, "code": {"type": "string", "maxLength": 64}, "detail": {"type": "string", "maxLength": 1024}, "request_id": {"type": "string", "maxLength": 128}, "retryable": {"type": "boolean"}, "remediation": {"type": ["string", "null"], "maxLength": 1024}}}
    }
  }
}

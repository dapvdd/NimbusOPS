# NimbusOps host agent configuration (placeholders only — never commit real secrets)
# Copy to agent/.env or export in the shell/systemd unit.

# Control server base URL. Use http://loopback ONLY for local development;
# across networks use HTTPS or a secure private tunnel.
NIMBUSOPS_AGENT_SERVER_URL=http://127.0.0.1:8000

# Enrollment token issued by the operator (same value as the server's
# NIMBUSOPS_ENROLLMENT_TOKEN). Needed once, at first enrollment.
NIMBUSOPS_AGENT_ENROLLMENT_TOKEN=change-me-enrollment-token

# Sampling interval in seconds (5..3600).
NIMBUSOPS_AGENT_INTERVAL=30

# Where the agent stores its host_id + agent token (created with 0600 on POSIX).
NIMBUSOPS_AGENT_STATE_FILE=~/.nimbusops/agent.json

#!/bin/sh
# INERT EXAMPLE — reviewed enrollment wrapper, not installed by default.
#
# Run it as the agent service account with a fresh single-use bootstrap token
# file (mode 0600, owned by that account). The token reaches the agent through
# a file, never argv, never a command line, never a log line.
#
# Required environment:
#   NIMBUSOPS_INSTALL_DIR  install root (contains agent/ and venv/)
#   NIMBUSOPS_SERVER_URL   control-plane base URL
#   NIMBUSOPS_TOKEN_FILE   bootstrap token file, 0600, owner-only
#   NIMBUSOPS_STATE_FILE   identity file path (must not exist for enroll; must exist for reenroll)
# Optional:
#   NIMBUSOPS_AGENT_ACTION enroll (default) or reenroll
#   NIMBUSOPS_AGENT_MODE   telemetry-only (default) or executor
#   NIMBUSOPS_PYTHON       interpreter (default: $NIMBUSOPS_INSTALL_DIR/venv/bin/python)
#
# Exit codes follow nimbusops_agent.main: 0 ok, 2 enrollment/config rejection,
# 3 credentials rejected. RestartPreventExitStatus=2 3 stops restart loops.
set -eu

: "${NIMBUSOPS_INSTALL_DIR:?set NIMBUSOPS_INSTALL_DIR}"
: "${NIMBUSOPS_SERVER_URL:?set NIMBUSOPS_SERVER_URL}"
: "${NIMBUSOPS_TOKEN_FILE:?set NIMBUSOPS_TOKEN_FILE}"
: "${NIMBUSOPS_STATE_FILE:?set NIMBUSOPS_STATE_FILE}"
python=${NIMBUSOPS_PYTHON:-$NIMBUSOPS_INSTALL_DIR/venv/bin/python}
action=${NIMBUSOPS_AGENT_ACTION:-enroll}
mode=${NIMBUSOPS_AGENT_MODE:-telemetry-only}

[ -f "$NIMBUSOPS_TOKEN_FILE" ] || { echo "bootstrap token file missing" >&2; exit 2; }
[ ! -L "$NIMBUSOPS_TOKEN_FILE" ] || { echo "bootstrap token file must not be a symlink" >&2; exit 2; }
[ "$(stat -c '%u:%a' "$NIMBUSOPS_TOKEN_FILE")" = "$(id -u):600" ] || {
  echo "bootstrap token file must be 0600 and owned by this account" >&2
  exit 2
}

case $action in
  enroll)
    [ ! -e "$NIMBUSOPS_STATE_FILE" ] || {
      echo "identity already exists; refusing to replace host identity" >&2
      exit 2
    }
    action_args=""
    ;;
  reenroll)
    [ -f "$NIMBUSOPS_STATE_FILE" ] || {
      echo "identity file does not exist; cannot re-enroll non-existent host" >&2
      exit 2
    }
    action_args="--reenroll"
    ;;
  *)
    echo "invalid NIMBUSOPS_AGENT_ACTION: $action" >&2
    exit 2
    ;;
esac

case $mode in
  telemetry-only) set -- --telemetry-only ;;
  executor) set -- ;;
  *) echo "invalid NIMBUSOPS_AGENT_MODE: $mode" >&2; exit 2 ;;
esac

if [ -n "$action_args" ]; then
  set -- "$@" $action_args
fi

exec "$python" -m nimbusops_agent "$@" \
  --server-url "$NIMBUSOPS_SERVER_URL" \
  --bootstrap-token-file "$NIMBUSOPS_TOKEN_FILE" \
  --state-file "$NIMBUSOPS_STATE_FILE"

# INERT EXAMPLE — replace every @TOKEN@ and keep this file mode 0600.
# @STATE_DIR@ is an absolute directory owned by the API service account.
# An absolute SQLite path needs four slashes after "sqlite:" once substituted.
NIMBUSOPS_DATABASE_URL=sqlite:///@STATE_DIR@/nimbusops.sqlite3
NIMBUSOPS_ENROLLMENT_MODE=bootstrap
NIMBUSOPS_TOKEN_PEPPER=@GENERATE_UNIQUE_RANDOM_SECRET@
# Exact UI origin. Cookies are SameSite=Strict and scoped to /api/v1.
NIMBUSOPS_BROWSER_ORIGINS=@UI_ORIGIN@
NIMBUSOPS_CORS_ORIGINS=@UI_ORIGIN@
# True behind HTTPS. Set false only for an explicitly loopback HTTP preview.
NIMBUSOPS_SESSION_COOKIE_SECURE=true

# NimbusOps control server configuration (placeholders only — never commit real secrets)
# Copy to backend/.env and edit.

# Token an operator must present to enroll a new agent. REQUIRED for enrollment;
# if unset/empty, enrollment is disabled (endpoint returns 503).
NIMBUSOPS_ENROLLMENT_TOKEN=change-me-enrollment-token

# SQLite URL. Relative paths resolve against backend/.
NIMBUSOPS_DATABASE_URL=sqlite:///./nimbusops.db

# Host status thresholds (seconds).
NIMBUSOPS_STALE_THRESHOLD_SECONDS=90
NIMBUSOPS_OFFLINE_THRESHOLD_SECONDS=600

# Telemetry rows kept per host.
NIMBUSOPS_TELEMETRY_RETENTION_ROWS=1440

# Comma-separated browser origins. Never "*".
NIMBUSOPS_CORS_ORIGINS=http://localhost:5173

# Optional extra pepper for stored agent-token hashes. If empty, the
# enrollment token is used as the pepper.
NIMBUSOPS_TOKEN_PEPPER=

# Phase 3B: operator session TTL (seconds, default 43200 = 12h).
NIMBUSOPS_OPERATOR_SESSION_TTL_SECONDS=43200

# Phase 3B: credential rotation grace period (seconds, default 300, max 3600).
NIMBUSOPS_CREDENTIAL_ROTATION_GRACE_SECONDS=300

# Phase 3B: claim timeout for RUNNING operations (seconds, default 600).
NIMBUSOPS_OP_CLAIM_TIMEOUT_SECONDS=600

# Phase 3B: default TTL for operator-issued bootstrap tokens (seconds,
# default 600, max 3600).
NIMBUSOPS_BOOTSTRAP_TOKEN_TTL_SECONDS=600
